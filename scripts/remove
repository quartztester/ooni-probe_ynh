#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# REMOVE SYSTEM CONFIGURATION
#=================================================

ynh_script_progression "Removing OONI Probe timer and service..."
systemctl disable "$app.timer" --quiet 2>/dev/null || true
ynh_safe_rm "/etc/systemd/system/$app.timer"
ynh_config_remove_systemd
systemctl daemon-reload

#=================================================
# END OF SCRIPT
#=================================================

ynh_safe_rm "/usr/share/yunohost/applogos/$app.png"
